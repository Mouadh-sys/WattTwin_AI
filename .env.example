# WattTwin AI — local development environment
# Copy to .env and adjust. Never commit .env.

# --- Backend ---
WATTTWIN_ENV=development
WATTTWIN_LOG_LEVEL=INFO
WATTTWIN_API_HOST=0.0.0.0
WATTTWIN_API_PORT=8000

# --- PostgreSQL (docker-compose exposes host port 5433 to avoid clashing with a local 5432) ---
POSTGRES_USER=watttwin
POSTGRES_PASSWORD=watttwin_dev_only
POSTGRES_DB=watttwin
WATTTWIN_DATABASE_URL=postgresql+psycopg://watttwin:watttwin_dev_only@localhost:5433/watttwin

# --- Industrial I/O (Phase 0 placeholders; values confirmed by the feasibility gate) ---
# The Open Industry Project simulator is the Modbus TCP *server* (remote I/O rack).
WATTTWIN_SIM_MODBUS_HOST=127.0.0.1
WATTTWIN_SIM_MODBUS_PORT=5020
WATTTWIN_MODBUS_UNIT_ID=1

# OpenPLC Runtime v4 REST API (Editor/management plane, not the process data path).
WATTTWIN_OPENPLC_URL=https://127.0.0.1:8443
WATTTWIN_OPENPLC_USER=openplc
WATTTWIN_OPENPLC_PASSWORD=openplc

# --- LLM / MCP (Phase 5; never required for the deterministic path) ---
# Keep empty until the agent phase. The optimizer and validator must run without these.
WATTTWIN_LLM_PROVIDER=
WATTTWIN_LLM_MODEL=
WATTTWIN_LLM_API_KEY=
WATTTWIN_MCP_SERVER_URL=
